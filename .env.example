# ==========================================
# Project : Sabbir Ahamed SQA Portfolio
# Module : Environment Variables (Example Template)
# ==========================================

# Port for the Express server (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Application Base URL
APP_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email API Key
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# Verified sender email address in your Brevo account
BREVO_SENDER_EMAIL=sabbircse72@gmail.com

# Recipient email address for contact form inquiries
BREVO_RECIPIENT_EMAIL=sabbircse72@gmail.com

# Gemini AI API Key for SQA Cover Letter and Test Case Assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Admin Security Passcode for Blog & Resume Management
ADMIN_PASSCODE=sabbir@sqa2026

# Optional Secret for signing Admin API session tokens across serverless restarts
# ADMIN_TOKEN_SECRET=YOUR_RANDOM_SECRET_STRING

# ==========================================
# Cloudflare Free Cloud Store (Choose Option A OR Option B — 100% Free Tier)
# Option A (Simplest — No Worker needed, No Credit Card, 1GB KV + 25MB/image):
# CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_KV_NAMESPACE_ID=YOUR_KV_NAMESPACE_ID
# CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_KV_API_TOKEN
#
# Option B (Optional Cloudflare Worker — Edge CDN with cloudflare/worker.js):
# CLOUDFLARE_WORKER_URL=https://sabbir-portfolio-sync.your-subdomain.workers.dev
# CLOUDFLARE_SYNC_SECRET=YOUR_WORKER_SYNC_SECRET
# ==========================================

