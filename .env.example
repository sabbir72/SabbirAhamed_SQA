# Port for the Express server (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Application Base URL
APP_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email API Key
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# Verified sender email address in your Brevo account
BREVO_SENDER_EMAIL=sabbircse72@gmail.com

# Recipient email address for contact form inquiries
BREVO_RECIPIENT_EMAIL=sabbircse72@gmail.com

# Gemini AI API Key for SQA Cover Letter and Test Case Assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Admin Security Passcode for Blog & Resume Management
ADMIN_PASSCODE=sabbir@sqa2026
